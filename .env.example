# 브라우저 요청은 API 서브도메인으로 전달합니다.
NEXT_PUBLIC_API_URL=https://api.seungwoo.i234.me

# Next 서버 컴포넌트와 서버 fetch는 내부 API 주소를 직접 사용합니다.
INTERNAL_API_URL=http://127.0.0.1:3333

# 서버의 공개 fallback 주소 (일반 배포에서는 미설정 시 기존 공개 API 사용)
# SERVER_PUBLIC_API_FALLBACK_URL=https://api.seungwoo.i234.me

# 로컬 격리 검증은 node scripts/isolated-preview.js로 실행합니다.
# 실행 스크립트가 아래 값을 모두 명시하고 외부 네트워크를 차단합니다.
# NEXT_PUBLIC_ISOLATED_PREVIEW=1
# NEXT_PUBLIC_API_URL=http://127.0.0.1:4319
# INTERNAL_API_URL=http://127.0.0.1:4319
# SERVER_PUBLIC_API_FALLBACK_URL=http://127.0.0.1:4319
# 선택 포트: ISOLATED_APP_PORT=4318 / ISOLATED_API_PORT=4319
# 검증 전용 계정: fixture-admin / fixture-only-password
# 모든 fixture 변경은 메모리에만 저장되며 재시작 시 초기화됩니다.
